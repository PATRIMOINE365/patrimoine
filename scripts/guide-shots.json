  {
    "id": null,
    "name": "wizard",
    "comment": "Walks the lease assistant page by page and photographs each one. V1.0.43: eight pages rather than ten, one per section of the lease drawer. Page 1 is a glossary; page 2 holds the property, the unit, the ownership block and the people; the rest follow the drawer's own order. Nothing is ever submitted.",
    "path": "/leases/wizard",
    "wait": "#wizard-step-counter",
    "settle": 900,
    "do": [
      {
        "capture": "wizard-intro",
        "settle": 300
      },
      {
        "click": "#wizard-next",
        "pause": 900
      },
      {
        "waitAttached": "#wizard-building-mode option[value=\"new\"]",
        "pause": 200
      },
      {
        "select": {
          "selector": "#wizard-building-mode",
          "value": "new"
        },
        "pause": 600
      },
      {
        "fill": {
          "selector": "#wizard-building-name",
          "value": "Frangipani Court"
        }
      },
      {
        "fill": {
          "selector": "#wizard-building-address",
          "value": "12 Independence Avenue, Accra"
        },
        "pause": 400
      },
      {
        "capture": "wizard-property",
        "settle": 500
      },
      {
        "click": "#wizard-next",
        "pause": 900
      },
      {
        "capture": "wizard-dates",
        "settle": 400
      },
      {
        "click": "#wizard-next",
        "pause": 900
      },
      {
        "fill": {
          "selector": "#wizard-deposit",
          "value": "12000"
        },
        "pause": 500
      },
      {
        "capture": "wizard-rent",
        "settle": 400
      },
      {
        "click": "#wizard-next",
        "pause": 900
      },
      {
        "click": "#wizard-next",
        "pause": 900
      },
      {
        "click": "#wizard-next",
        "pause": 900
      },
      {
        "click": "#wizard-next",
        "pause": 900
      },
      {
        "capture": "wizard-review",
        "settle": 500
      }
    ]
  },
