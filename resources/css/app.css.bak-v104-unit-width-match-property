#existing-unit-modal .text-slate-900,
#existing-unit-modal .text-slate-800,
#existing-unit-modal .text-slate-700,
#existing-unit-modal .text-patrimoine-950 {
    color: var(--pm-text) !important;
}

#existing-unit-modal .text-slate-600 {
    color: var(--pm-text-secondary) !important;
}

#existing-unit-modal .text-slate-500 {
    color: var(--pm-text-muted) !important;
}

#existing-unit-modal .text-slate-400 {
    color: var(--pm-text-subtle) !important;
}


/* Borders */
#existing-unit-modal .border-slate-100,
#existing-unit-modal .border-slate-200,
#existing-unit-modal .border-patrimoine-100 {
    border-color: var(--pm-border) !important;
}


/* Parent Property context */
#existing-unit-modal .bg-patrimoine-50 {
    border-color: var(--pm-border) !important;
    background: var(--pm-surface-subtle) !important;
}

#existing-unit-modal .text-patrimoine-600 {
    color: var(--pm-text-muted) !important;
}


/* Inputs */
#existing-unit-modal
input:not([type="checkbox"]):not([type="radio"]),
#existing-unit-modal
textarea,
#existing-unit-modal
select {
    border-color: var(--pm-border) !important;
    background: var(--pm-surface) !important;
    color: var(--pm-text) !important;
}

#existing-unit-modal input::placeholder,
#existing-unit-modal textarea::placeholder {
    color: var(--pm-text-subtle) !important;
}


/* Error */
#existing-unit-modal .bg-red-50 {
    background:
        color-mix(
            in srgb,
            var(--pm-danger-text) 9%,
            var(--pm-surface)
        ) !important;
}

#existing-unit-modal .text-red-700 {
    color: var(--pm-danger-text) !important;
}


/*
 * The shared sm drawer already makes these equal.
 * State it explicitly here so legacy Unit rules cannot override it.
 */
#existing-unit-modal .pm-drawer-footer {
    gap: 0.75rem;
}

#existing-unit-modal .pm-drawer-footer
.pm-button-secondary,
#existing-unit-modal .pm-drawer-footer
.pm-button-primary {
    flex: 1 1 0 !important;
    width: auto !important;
