/* V1.0.4 TENANTS WORKSPACE STEP 1 */

/*
|--------------------------------------------------------------------------
| Tenant Workspace
|--------------------------------------------------------------------------
|
| Step 1 modernizes the Tenant directory and page shell while deliberately
| preserving the existing read-only Tenant detail and all accounting/API
| behavior.
|
*/

.pm-tenants-page {
    color: var(--pm-text);
}

.pm-tenants-page .text-slate-950,
.pm-tenants-page .text-slate-900,
.pm-tenants-page .text-slate-800,
.pm-tenants-page .text-slate-700 {
    color: var(--pm-text) !important;
}

.pm-tenants-page .text-slate-600 {
    color: var(--pm-text-secondary) !important;
}

.pm-tenants-page .text-slate-500,
.pm-tenants-page .text-slate-400 {
    color: var(--pm-text-muted) !important;
}

.pm-tenants-page .border-slate-100,
.pm-tenants-page .border-slate-200 {
    border-color: var(--pm-border) !important;
}

.pm-tenants-page .bg-white {
    background: var(--pm-surface) !important;
}

.pm-tenants-page .bg-slate-50,
.pm-tenants-page .bg-slate-50\/50,
.pm-tenants-page .bg-slate-100 {
    background: var(--pm-surface-subtle) !important;
}

.pm-tenants-workspace {
    display: grid;
    grid-template-columns:
        minmax(18rem, 22rem)
        minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
}

/* --------------------------------------------------------------------------
   Directory
   -------------------------------------------------------------------------- */

.pm-tenant-directory {
    position: sticky;
    top: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--pm-border);
    border-radius: 0.875rem;
    background: var(--pm-surface);
    box-shadow:
        0 1px 2px rgb(15 23 42 / 0.04);
}

.pm-tenant-directory-header {
    border-bottom: 1px solid var(--pm-border);
    padding: 1.125rem;
}

.pm-tenant-search-input {
    min-height: 2.75rem;
}

.pm-tenant-directory-list {
    min-height: 28rem;
    max-height: calc(100vh - 20rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
}

.pm-tenant-directory-row {
    position: relative;
    display: grid;
    width: 100%;
    grid-template-columns:
        2.5rem
        minmax(0, 1fr)
        auto;
    align-items: center;
    gap: 0.75rem;
    border: 0;
    border-bottom: 1px solid var(--pm-border);
    background: transparent;
    padding: 0.875rem 1rem;
    text-align: left;
    color: var(--pm-text);
    cursor: pointer;
    transition:
        background-color 150ms ease,
        box-shadow 150ms ease;
}

.pm-tenant-directory-row:last-child {
    border-bottom: 0;
}

.pm-tenant-directory-row:hover {
    background: var(--pm-hover);
}

.pm-tenant-directory-row:focus-visible {
    z-index: 1;
    outline: none;
    box-shadow:
        inset 0 0 0 2px
        var(--color-patrimoine-500);
}

.pm-tenant-directory-row-selected {
    background: var(--pm-selected);
}

.pm-tenant-directory-row-selected:hover {
    background: var(--pm-selected);
}

.pm-tenant-directory-row-selected::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--color-patrimoine-700);
    content: "";
}

.pm-tenant-directory-avatar {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--pm-border);
    border-radius: 9999px;
    background: var(--pm-surface-subtle);
    color: var(--pm-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.025em;
}

.pm-tenant-directory-row-selected
.pm-tenant-directory-avatar {
    border-color:
        color-mix(
            in srgb,
            var(--color-patrimoine-600) 28%,
            var(--pm-border)
        );
    background:
        color-mix(
            in srgb,
            var(--color-patrimoine-500) 10%,
            var(--pm-surface)
        );
    color: var(--color-patrimoine-700);
}

html[data-theme="dark"]
.pm-tenant-directory-row-selected
.pm-tenant-directory-avatar {
    color:
        color-mix(
            in srgb,
            var(--color-patrimoine-500) 55%,
            white
        );
}

.pm-tenant-directory-content {
    display: block;
    min-width: 0;
}

.pm-tenant-directory-name,
.pm-tenant-directory-contact,
.pm-tenant-directory-secondary {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.pm-tenant-directory-name {
    color: var(--pm-text);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.25rem;
}

.pm-tenant-directory-contact {
    margin-top: 0.15rem;
    color: var(--pm-text-secondary);
    font-size: 0.75rem;
    line-height: 1.125rem;
}

.pm-tenant-directory-secondary {
    margin-top: 0.05rem;
    color: var(--pm-text-muted);
    font-size: 0.6875rem;
    line-height: 1rem;
}

.pm-tenant-directory-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--pm-text-muted);
}

.pm-tenant-directory-type {
    max-width: 4.5rem;
    overflow: hidden;
    border: 1px solid var(--pm-border);
    border-radius: 9999px;
    background: var(--pm-surface-subtle);
    padding: 0.2rem 0.45rem;
    color: var(--pm-text-muted);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.pm-tenant-directory-chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition:
        transform 150ms ease,
        color 150ms ease;
}

.pm-tenant-directory-row:hover
.pm-tenant-directory-chevron {
    transform: translateX(2px);
    color: var(--pm-text-secondary);
}

.pm-tenant-directory-row-selected
.pm-tenant-directory-chevron {
    color: var(--color-patrimoine-700);
}

.pm-tenant-directory-pagination {
    border-top: 1px solid var(--pm-border);
    background: var(--pm-surface);
    padding: 0.75rem 1rem;
}

/* Existing generated pagination controls. */
.pm-tenant-directory-pagination button {
    border-color: var(--pm-border) !important;
    background: var(--pm-surface) !important;
    color: var(--pm-text-secondary) !important;
}

.pm-tenant-directory-pagination button:hover:not(:disabled) {
    border-color: var(--pm-border-strong) !important;
    background: var(--pm-hover) !important;
    color: var(--pm-text) !important;
}

/* --------------------------------------------------------------------------
   Detail shell
   -------------------------------------------------------------------------- */

.pm-tenant-detail-shell {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--pm-border);
    border-radius: 0.875rem;
    background: var(--pm-surface);
    box-shadow:
        0 1px 2px rgb(15 23 42 / 0.04);
}

/*
 * Step 1 does not restructure Tenant detail markup yet. These rules make
 * its existing generated surfaces readable in both application themes.
 */
.pm-tenant-detail-shell .bg-white {
    background: var(--pm-surface) !important;
}

.pm-tenant-detail-shell .bg-slate-50,
.pm-tenant-detail-shell .bg-slate-50\/50,
.pm-tenant-detail-shell .bg-slate-100 {
    background: var(--pm-surface-subtle) !important;
}

.pm-tenant-detail-shell .border-slate-100,
.pm-tenant-detail-shell .border-slate-200 {
    border-color: var(--pm-border) !important;
}

/* --------------------------------------------------------------------------
   Responsive behavior
   -------------------------------------------------------------------------- */

@media (max-width: 1099px) {
    .pm-tenants-workspace {
        grid-template-columns: 1fr;
    }

    .pm-tenant-directory {
        position: static;
    }

    .pm-tenant-directory-list {
        min-height: 0;
        max-height: 22rem;
    }
}

@media (max-width: 639px) {
    .pm-tenants-page {
        width: 100%;
    }

    .pm-tenants-workspace {
        gap: 1rem;
    }

    .pm-tenant-directory-header {
        padding: 1rem;
    }

    .pm-tenant-directory-row {
        grid-template-columns:
            2.375rem
            minmax(0, 1fr)
            auto;
        gap: 0.625rem;
        padding:
            0.8125rem
            0.875rem;
    }

    .pm-tenant-directory-avatar {
        width: 2.375rem;
        height: 2.375rem;
    }

    .pm-tenant-directory-type {
        display: none;
    }

    .pm-tenant-directory-list {
        max-height: 20rem;
    }
}

/* END V1.0.4 TENANTS WORKSPACE STEP 1 */

