/*
|--------------------------------------------------------------------------
| V1.0.4 Existing Unit Drawer Motion
|--------------------------------------------------------------------------
|
| Scoped exclusively to #existing-unit-modal.
| The existing Unit modal markup remains unchanged.
|
*/

/* Backdrop begins transparent. */

#existing-unit-modal
#existing-unit-modal-backdrop {
    opacity: 0;

    transition:
        opacity 800ms ease;
}


/*
 * Existing structure:
 *
 * #existing-unit-modal
 *   backdrop
 *   positioning wrapper
 *     actual right-side panel
 *
 * Keep the panel completely outside the viewport until opened.
 */

#existing-unit-modal
> div:not(#existing-unit-modal-backdrop)
> div {
    transform: translateX(100%);

    transition:
        transform 800ms
        cubic-bezier(0.22, 1, 0.36, 1);

    will-change: transform;
}


/* Open state */

#existing-unit-modal.existing-unit-slide-open
#existing-unit-modal-backdrop {
    opacity: 1;
}

#existing-unit-modal.existing-unit-slide-open
> div:not(#existing-unit-modal-backdrop)
> div {
    transform: translateX(0);
}


/* Closing state */

#existing-unit-modal.existing-unit-slide-closing
#existing-unit-modal-backdrop {
    opacity: 0;
}

#existing-unit-modal.existing-unit-slide-closing
> div:not(#existing-unit-modal-backdrop)
> div {
    transform: translateX(100%);
}


/* Accessibility */

@media (prefers-reduced-motion: reduce) {
    #existing-unit-modal
    #existing-unit-modal-backdrop,

    #existing-unit-modal
    > div:not(#existing-unit-modal-backdrop)
    > div {
        transition: none;
    }
}


/* END V1.0.4 Existing Unit Drawer Motion */


/*
|--------------------------------------------------------------------------
| V1.0.4 Existing Unit Drawer Footer
|--------------------------------------------------------------------------
*/

#existing-unit-modal
.existing-unit-drawer-footer {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    flex-shrink: 0;

    width: 100%;

    gap: 0.75rem;

    border-top: 1px solid var(--pm-border);
    background: var(--pm-surface);

    padding: 0.875rem 1.375rem;
}

#existing-unit-modal
.existing-unit-drawer-footer
.pm-button-secondary,
#existing-unit-modal
.existing-unit-drawer-footer
.pm-button-primary {
    width: 100%;
    min-width: 0;
    min-height: 3rem;

    margin: 0;

    justify-content: center;

    font-size: 0.9375rem;
}


/* END V1.0.4 Existing Unit Drawer Footer */


/*
|--------------------------------------------------------------------------
| V1.0.4 Existing Unit Drawer — Closing Hit Testing
|--------------------------------------------------------------------------
|
| During the 800ms closing animation the legacy modal root still covers the
| viewport. Stop it intercepting clicks as soon as closing begins.
|
*/

#existing-unit-modal.existing-unit-slide-active {
    pointer-events: auto;
}

#existing-unit-modal.existing-unit-slide-closing {
    pointer-events: none !important;
}

#existing-unit-modal.existing-unit-slide-closing
#existing-unit-modal-backdrop,
#existing-unit-modal.existing-unit-slide-closing
> div:not(#existing-unit-modal-backdrop),
#existing-unit-modal.existing-unit-slide-closing
> div:not(#existing-unit-modal-backdrop)
> div {
    pointer-events: none !important;
}


/* END V1.0.4 Existing Unit Drawer — Closing Hit Testing */
