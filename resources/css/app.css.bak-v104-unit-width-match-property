@import 'tailwindcss';

@source '../views/**/*.blade.php';
@source '../js/**/*.js';
@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';

@theme {
    --font-sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji',
        'Segoe UI Symbol', 'Noto Color Emoji';

    --color-patrimoine-50: #f4f8f6;
    --color-patrimoine-100: #e5efe9;
    --color-patrimoine-200: #cbded2;
    --color-patrimoine-300: #a3c5af;
    --color-patrimoine-400: #73a587;
    --color-patrimoine-500: #528969;
    --color-patrimoine-600: #3f6e54;
    --color-patrimoine-700: #345845;
    --color-patrimoine-800: #2c4739;
    --color-patrimoine-900: #253b31;
    --color-patrimoine-950: #12221b;
}

/*
|--------------------------------------------------------------------------
| Patrimoine Semantic Theme
|--------------------------------------------------------------------------
|
| Application UI should consume these semantic colours rather than knowing
| whether a surface is slate-50, white, slate-950, etc.
|
| This gives Patrimoine one visual vocabulary that can be switched between
| Light and Dark presentation without changing business-page markup.
|
| data-theme is applied to <html> before the application paints.
|
*/

:root,
html[data-theme="light"] {
    color-scheme: light;

    --pm-page: #f7f8f7;
    --pm-surface: #ffffff;
    --pm-surface-subtle: #f8fafc;
    --pm-surface-muted: #f1f5f9;
    --pm-surface-elevated: #ffffff;

    --pm-text: #0f172a;
    --pm-text-secondary: #334155;
    --pm-text-muted: #64748b;
    --pm-text-subtle: #94a3b8;

    --pm-border: #e2e8f0;
    --pm-border-subtle: #f1f5f9;
    --pm-border-strong: #cbd5e1;

    --pm-hover: #f8fafc;
    --pm-selected: #f4f8f6;

    --pm-input-background: #ffffff;
    --pm-input-disabled: #f8fafc;

    --pm-overlay: rgb(2 6 23 / 0.50);

    --pm-success-background: #f0fdf4;
    --pm-success-border: #bbf7d0;
    --pm-success-text: #15803d;

    --pm-warning-background: #fffbeb;
    --pm-warning-border: #fde68a;
    --pm-warning-text: #92400e;

    --pm-danger-background: #fef2f2;
    --pm-danger-border: #fecaca;
    --pm-danger-text: #b91c1c;

    --pm-info-background: #eff6ff;
    --pm-info-border: #bfdbfe;
    --pm-info-text: #1d4ed8;
}

html[data-theme="dark"] {
    color-scheme: dark;

    --pm-page: #0f1412;
    --pm-surface: #171d1a;
    --pm-surface-subtle: #1c231f;
    --pm-surface-muted: #222a26;
    --pm-surface-elevated: #202722;

    --pm-text: #f1f5f3;
    --pm-text-secondary: #d3ddd7;
    --pm-text-muted: #9eaca4;
    --pm-text-subtle: #75847b;

    --pm-border: #303a34;
    --pm-border-subtle: #27302b;
    --pm-border-strong: #465249;

    --pm-hover: #202822;
    --pm-selected: #25352c;

    --pm-input-background: #171d1a;
    --pm-input-disabled: #202722;

    --pm-overlay: rgb(0 0 0 / 0.64);

    --pm-success-background: #14251b;
    --pm-success-border: #28543a;
    --pm-success-text: #86d7a4;

    --pm-warning-background: #292314;
    --pm-warning-border: #5c4b20;
    --pm-warning-text: #f1cf70;

    --pm-danger-background: #2b1718;
    --pm-danger-border: #603034;
    --pm-danger-text: #f2a0a5;

    --pm-info-background: #172331;
    --pm-info-border: #294866;
    --pm-info-text: #9cc9f2;
}

html {
    background: var(--pm-page);
}

body {
    min-height: 100vh;
    background: var(--pm-page);
    color: var(--pm-text);
}

[x-cloak] {
    display: none !important;
}

/*
|--------------------------------------------------------------------------
| V1.0.3 Role-Aware Application UI
|--------------------------------------------------------------------------
|
| Keep authorization visibility separate from Tailwind's normal `hidden`
| utility. Feature JavaScript may legitimately add/remove `hidden` for
| modals and conditional sections, but it must never reveal an action that
| RBAC has hidden.
|
*/

.rbac-hidden {
    display: none !important;
}

/*
|--------------------------------------------------------------------------
| V1.0.4 Application Shell
|--------------------------------------------------------------------------
*/

.shell-admin-only {
    display: none !important;
}

/*
 * A role cached from a previously verified /api/auth/me response may reveal
 * the Administrator shell immediately on subsequent navigation.
 *
 * Browser authorization will still re-evaluate the capability after the
 * current /api/auth/me request completes. Server authorization remains
 * authoritative.
 */
html[data-shell-role="administrator"]
.shell-admin-only {
    display: block !important;
}

.shell-menu-item {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.625rem;
    border-radius: 0.5rem;
    padding: 0.625rem 0.75rem;
    text-align: left;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--pm-text-secondary);
    transition:
        background-color 150ms ease,
        color 150ms ease;
}

.shell-menu-item:hover {
    background: var(--pm-hover);
    color: var(--pm-text);
}

.theme-option {
    border-radius: 0.375rem;
    padding: 0.4rem 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--pm-text-muted);
    transition:
        background-color 150ms ease,
        color 150ms ease,
        box-shadow 150ms ease;
}

.theme-option:hover {
    color: var(--pm-text);
}

.theme-option[data-selected="true"] {
    background: var(--pm-surface-elevated);
    color: var(--pm-text);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
}

/* V1.0.4 COMPLETE UI PRIMITIVES */

/* --------------------------------------------------------------------------
   Form controls
   -------------------------------------------------------------------------- */

.pm-field-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--pm-text-secondary);
}

.pm-input {
    display: block;
    width: 100%;
    min-height: 2.625rem;
    border: 1px solid var(--pm-border);
    border-radius: 0.5rem;
    background: var(--pm-input-background);
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--pm-text);
    outline: none;
    transition:
        border-color 150ms ease,
        box-shadow 150ms ease,
        background-color 150ms ease;
}

.pm-input:hover:not(:disabled) {
    border-color: var(--pm-border-strong);
}

.pm-input:focus {
    border-color: var(--color-patrimoine-500);
    box-shadow:
        0 0 0 3px
        color-mix(
            in srgb,
            var(--color-patrimoine-500) 16%,
            transparent
        );
}

.pm-input:disabled {
    cursor: not-allowed;
    background: var(--pm-input-disabled);
    color: var(--pm-text-muted);
}

select.pm-input {
    cursor: pointer;
}

/* --------------------------------------------------------------------------
   Buttons
   -------------------------------------------------------------------------- */

.pm-button-primary,
.pm-button-secondary {
    display: inline-flex;
    min-height: 2.625rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
    transition:
        background-color 150ms ease,
        border-color 150ms ease,
        color 150ms ease,
        box-shadow 150ms ease,
        opacity 150ms ease;
}

.pm-button-primary {
    border: 1px solid var(--color-patrimoine-800);
    background: var(--color-patrimoine-800);
    color: white;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.08);
}

.pm-button-primary:hover:not(:disabled) {
    border-color: var(--color-patrimoine-900);
    background: var(--color-patrimoine-900);
}

.pm-button-primary:disabled {
    cursor: not-allowed;
    opacity: 0.5;
}

.pm-button-secondary {
    border: 1px solid var(--pm-border);
    background: var(--pm-surface);
    color: var(--pm-text-secondary);
}

.pm-button-secondary:hover:not(:disabled) {
    border-color: var(--pm-border-strong);
    background: var(--pm-hover);
    color: var(--pm-text);
}

/* --------------------------------------------------------------------------
   Card
   -------------------------------------------------------------------------- */

.pm-card {
    border: 1px solid var(--pm-border);
    border-radius: 0.875rem;
    background: var(--pm-surface);
}

/* --------------------------------------------------------------------------
   Drawer
   -------------------------------------------------------------------------- */

.pm-drawer {
    isolation: isolate;

    /*
     * Closed drawers remain rendered off-screen.
     * This gives the browser a real starting position
     * for the opening transition.
     */
    visibility: hidden;
    pointer-events: none;
}

.pm-drawer.pm-drawer-active {
    visibility: visible;
    pointer-events: auto;
}

.pm-drawer.pm-drawer-closing {
    visibility: visible;
    pointer-events: none;
}

.pm-drawer-backdrop {
    background: rgb(15 23 42 / 0.46);
    backdrop-filter: blur(1.5px);
    opacity: 0;
    transition: opacity 800ms ease;
}

.pm-drawer-panel {
    background: var(--pm-surface);
    border-left: 1px solid var(--pm-border);
    box-shadow:
        -12px 0 30px rgb(15 23 42 / 0.10),
        -2px 0 8px rgb(15 23 42 / 0.05);
    transform: translateX(100%);
    transition:
        transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
}

.pm-drawer.pm-drawer-open .pm-drawer-backdrop {
    opacity: 1;
}

.pm-drawer.pm-drawer-open .pm-drawer-panel {
    transform: translateX(0);
}

.pm-drawer.pm-drawer-closing .pm-drawer-backdrop {
    opacity: 0;
}

.pm-drawer.pm-drawer-closing .pm-drawer-panel {
    transform: translateX(100%);
}

.pm-drawer-header {
    display: flex;
    flex-shrink: 0;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--pm-border);
    background: var(--pm-surface);
    padding: 1.25rem 1.375rem;
}

.pm-drawer-footer {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
    gap: 0.625rem;
    border-top: 1px solid var(--pm-border);
    background: var(--pm-surface);
    padding: 0.875rem 1.375rem;
}

.pm-icon-button {
    display: inline-flex;
    width: 2.125rem;
    height: 2.125rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--pm-text-muted);
    transition:
        background-color 150ms ease,
        color 150ms ease;
}

.pm-icon-button:hover {
    background: var(--pm-hover);
    color: var(--pm-text);
}

/* Compact drawer forms should not feel unnecessarily spacious. */
.pm-drawer-panel form > div:first-child {
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
}

/* --------------------------------------------------------------------------
   Responsive drawer behavior
   -------------------------------------------------------------------------- */

@media (max-width: 639px) {
    .pm-drawer-panel {
        max-width: 100%;
    }

    .pm-drawer-header {
        padding: 1rem 1.125rem;
    }

    .pm-drawer-footer {
        padding: 0.875rem 1.125rem;
    }

    .pm-drawer-footer > * {
        flex: 1;
    }
}

@media (prefers-reduced-motion: reduce) {
    .pm-drawer-backdrop,
    .pm-drawer-panel {
        transition: none;
    }
}


/* V1.0.4 Drawer Footer Button Balance */
.pm-drawer-footer .pm-button-primary,
.pm-drawer-footer .pm-button-secondary {
    min-width: 7.25rem;
}


/* V1.0.4 Compact Drawer Footer Actions */
.pm-drawer[data-drawer-width="sm"] .pm-drawer-footer {
    gap: 0.75rem;
}

.pm-drawer[data-drawer-width="sm"] .pm-drawer-footer
.pm-button-primary,
.pm-drawer[data-drawer-width="sm"] .pm-drawer-footer
.pm-button-secondary {
    flex: 1 1 0;
    min-width: 0;
    min-height: 3rem;
    padding-inline: 1rem;
    font-size: 0.9375rem;
}


/*
|--------------------------------------------------------------------------
| V1.0.4 Settings Workspace
|--------------------------------------------------------------------------
*/

.pm-settings-shell {
    overflow: visible;
}

.pm-settings-intro {
    margin-bottom: 1.25rem;
    padding: 0 0.125rem;
}

.pm-settings-form-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
}

.pm-settings-form-grid > section {
    min-width: 0;
    border: 1px solid var(--pm-border);
    border-radius: 0.875rem;
    background: var(--pm-surface);
    padding: 1.25rem;
}

.pm-settings-form-grid > section > h3 {
    color: var(--pm-text);
}

.pm-settings-form-grid > section > p {
    color: var(--pm-text-muted);
}

/*
 * The first major identity/contact areas deserve the full content width.
 * Smaller configuration groups can sit side-by-side on larger screens.
 */
@media (min-width: 1024px) {
    .pm-settings-form-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .pm-settings-form-grid > section:nth-child(1),
    .pm-settings-form-grid > section:nth-child(2),
    .pm-settings-form-grid > section:nth-child(6),
    .pm-settings-form-grid > .pm-settings-notes-card {
        grid-column: 1 / -1;
    }
}

/*
|--------------------------------------------------------------------------
| Settings Form Controls
|--------------------------------------------------------------------------
|
| Existing IDs and markup are intentionally preserved. These selectors
| provide semantic-theme styling without rewriting Settings business logic.
|
*/

.pm-settings-page label {
    color: var(--pm-text-secondary);
}

.pm-settings-page input:not([type="checkbox"]):not([type="radio"]),
.pm-settings-page select,
.pm-settings-page textarea {
    width: 100%;
    border-color: var(--pm-border) !important;
    background: var(--pm-input-background) !important;
    color: var(--pm-text) !important;
}

.pm-settings-page input:not([type="checkbox"]):not([type="radio"]):hover,
.pm-settings-page select:hover,
.pm-settings-page textarea:hover {
    border-color: var(--pm-border-strong) !important;
}

.pm-settings-page input:not([type="checkbox"]):not([type="radio"]):focus,
.pm-settings-page select:focus,
.pm-settings-page textarea:focus {
    border-color: var(--color-patrimoine-500) !important;
    box-shadow:
        0 0 0 3px
        color-mix(
            in srgb,
            var(--color-patrimoine-500) 16%,
            transparent
        ) !important;
}

.pm-settings-page input::placeholder,
.pm-settings-page textarea::placeholder {
    color: var(--pm-text-subtle);
}

.pm-settings-page .text-slate-950,
.pm-settings-page .text-slate-900,
.pm-settings-page .text-slate-800,
.pm-settings-page .text-slate-700 {
    color: var(--pm-text) !important;
}

.pm-settings-page .text-slate-600 {
    color: var(--pm-text-secondary) !important;
}

.pm-settings-page .text-slate-500,
.pm-settings-page .text-slate-400 {
    color: var(--pm-text-muted) !important;
}

.pm-settings-page .border-slate-100,
.pm-settings-page .border-slate-200 {
    border-color: var(--pm-border) !important;
}

.pm-settings-page .bg-white {
    background: var(--pm-surface) !important;
}

/*
|--------------------------------------------------------------------------
| Settings Save Bar
|--------------------------------------------------------------------------
*/

.pm-settings-save-bar {
    position: sticky;
    bottom: 1rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    border: 1px solid var(--pm-border);
    border-radius: 0.875rem;
    background:
        color-mix(
            in srgb,
            var(--pm-surface) 94%,
            transparent
        );
    padding: 0.75rem 0.875rem 0.75rem 1.125rem;
    box-shadow:
        0 8px 30px rgb(15 23 42 / 0.08);
    backdrop-filter: blur(12px);
}

@media (max-width: 639px) {
    .pm-settings-intro,
    .pm-settings-form-grid > section {
        padding: 1rem;
    }

    .pm-settings-save-bar {
        bottom: 0.75rem;
        padding: 0.75rem;
    }

    .pm-settings-save-bar > div:first-child {
        display: none;
    }

    .pm-settings-save-bar .pm-button-primary {
        width: 100%;
    }
}


/*
|--------------------------------------------------------------------------
| V1.0.4 Activity Log Workspace
|--------------------------------------------------------------------------
*/

.pm-activity-log-shell {
    margin-top: 1.75rem;
    overflow: hidden;
    border: 1px solid var(--pm-border);
    border-radius: 0.875rem;
    background: var(--pm-surface);
}

.pm-activity-log-filters {
    display: grid;
    gap: 1rem;
    border-bottom: 1px solid var(--pm-border);
    background: var(--pm-surface);
    padding: 1.25rem;
    grid-template-columns:
        repeat(1, minmax(0, 1fr));
}

.pm-activity-log-filters > div {
    min-width: 0;
}

@media (min-width: 768px) {
    .pm-activity-log-filters {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .pm-activity-log-filters > div:first-child {
        grid-column: 1 / -1;
    }
}

@media (min-width: 1280px) {
    .pm-activity-log-filters {
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
    }

    .pm-activity-log-filters > div:first-child {
        grid-column: span 2;
    }
}

/*
 * Activity Detail contains immutable structured values and may need more
 * horizontal room than a small CRUD form.
 */
.pm-drawer[data-drawer-width="lg"] .pm-drawer-panel {
    width: min(100%, 42rem);
}

/*
 * Keep generated Activity Log detail surfaces within the semantic theme.
 */
.pm-activity-log-page .rounded-full.bg-patrimoine-50 {
    background: var(--pm-selected);
}

html[data-theme="dark"]
.pm-activity-log-page .rounded-full.bg-patrimoine-50 {
    color: var(--pm-success-text);
}

@media (max-width: 639px) {
    .pm-activity-log-filters {
        padding: 1rem;
    }

    .pm-drawer[data-drawer-width="lg"] .pm-drawer-panel {
        width: 100%;
    }
}

/*
|--------------------------------------------------------------------------
| V1.0.4 Record Payment Drawer Theme Fix
|--------------------------------------------------------------------------
|
| The Payment form predates the semantic V1.0.4 UI primitives and still
| contains many slate/white utility classes. Keep its markup and business
| logic intact while making the drawer follow the active application theme.
|
*/

#payment-modal .pm-drawer-panel {
    color: var(--pm-text);
}

/* --------------------------------------------------------------------------
   Headings, labels and supporting copy
   -------------------------------------------------------------------------- */

#payment-modal .text-slate-950,
#payment-modal .text-slate-900,
#payment-modal .text-slate-800,
#payment-modal .text-slate-700 {
    color: var(--pm-text) !important;
}

#payment-modal .text-slate-600 {
    color: var(--pm-text-secondary) !important;
}

#payment-modal .text-slate-500,
#payment-modal .text-slate-400 {
    color: var(--pm-text-muted) !important;
}

/*
 * Some original section headings inherited very dark Tailwind text colors
 * which became almost invisible on the dark surface.
 */
#payment-modal h3,
#payment-modal label {
    color: var(--pm-text-secondary);
}

#payment-modal h3 {
    color: var(--pm-text) !important;
}

/* --------------------------------------------------------------------------
   Dividers and cards
   -------------------------------------------------------------------------- */

#payment-modal .border-slate-100,
#payment-modal .border-slate-200,
#payment-modal .border-slate-300 {
    border-color: var(--pm-border) !important;
}

#payment-modal .bg-white {
    background: var(--pm-surface) !important;
}

#payment-modal .bg-slate-50,
#payment-modal .bg-slate-50\/70 {
    background: var(--pm-surface-subtle) !important;
}

/*
 * Tenant / Owner source cards.
 */
#payment-modal label:has(
    input[name="payment_source"]
) {
    border-color: var(--pm-border) !important;
    background: var(--pm-surface-subtle);
    color: var(--pm-text);
}

#payment-modal label:has(
    input[name="payment_source"]
):hover {
    border-color: var(--pm-border-strong) !important;
    background: var(--pm-hover);
}

#payment-modal label:has(
    input[name="payment_source"]:checked
) {
    border-color: var(--color-patrimoine-500) !important;
    background:
        color-mix(
            in srgb,
            var(--color-patrimoine-500) 8%,
            var(--pm-surface)
        );
}

/* --------------------------------------------------------------------------
   Form controls
   -------------------------------------------------------------------------- */

#payment-modal input:not([type="radio"]):not([type="checkbox"]),
#payment-modal select,
#payment-modal textarea {
    border-color: var(--pm-border) !important;
    background: var(--pm-input-background) !important;
    color: var(--pm-text) !important;
}

#payment-modal input:not([type="radio"]):not([type="checkbox"])::placeholder,
#payment-modal textarea::placeholder {
    color: var(--pm-text-subtle) !important;
    opacity: 1;
}

#payment-modal input:not([type="radio"]):not([type="checkbox"]):hover:not(:disabled),
#payment-modal select:hover:not(:disabled),
#payment-modal textarea:hover:not(:disabled) {
    border-color: var(--pm-border-strong) !important;
}

#payment-modal input:not([type="radio"]):not([type="checkbox"]):focus,
#payment-modal select:focus,
#payment-modal textarea:focus {
    border-color: var(--color-patrimoine-500) !important;
    box-shadow:
        0 0 0 3px
        color-mix(
            in srgb,
            var(--color-patrimoine-500) 18%,
            transparent
        ) !important;
}

/*
 * Disabled Lease / Unit selectors previously stayed almost white in dark
 * mode because of their historical disabled:bg-slate-50 utilities.
 */
#payment-modal input:disabled,
#payment-modal select:disabled,
#payment-modal textarea:disabled {
    cursor: not-allowed;
    border-color: var(--pm-border) !important;
    background: var(--pm-input-disabled) !important;
    color: var(--pm-text-muted) !important;
    opacity: 1;
}

/*
 * Native select popup/options should also follow the active color scheme
 * where the browser supports it.
 */
#payment-modal select,
#payment-modal option {
    color: var(--pm-text);
    background: var(--pm-input-background);
}

html[data-theme="dark"] #payment-modal {
    color-scheme: dark;
}

html[data-theme="light"] #payment-modal {
    color-scheme: light;
}

/* --------------------------------------------------------------------------
   Search result surfaces and selected-party cards
   -------------------------------------------------------------------------- */

#payment-modal #tenant-payment-search-results,
#payment-modal #owner-payment-search-results {
