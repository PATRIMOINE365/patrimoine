# The server this build talks to, baked in at build time by Vite.
#
# There is deliberately NO default: a build that does not know which server
# it talks to should fail on the first screen (see src/main.js) rather than
# silently point at the wrong one. Copy this file to .env (or .env.local,
# which outranks .env) and set exactly one of:
#
#   Production:     https://app.patrimoine365.com/api/v1
#   Pre-production: https://patrimoine-dev.kalitygroup.com/api/v1   (internal, nx-vps-01)
#
# The former https://patrimoine.koaditech.com host is decommissioned.
VITE_API_BASE=

# Fallback version for `npm run dev` in a browser. On a device the launch
# gate reads CFBundleShortVersionString from the bundle instead, so the two
# cannot drift apart where it matters.
VITE_APP_VERSION=1.0.0
