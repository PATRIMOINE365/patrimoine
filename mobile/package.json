{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "patrimoine-mobile",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "node --test \"tests/**/*.test.js\"",
        "sync": "npm run build && cap sync",
        "ios": "npm run build && cap sync ios && cap open ios",
        "build:tokens": "node scripts/build-tokens.mjs && node scripts/build-ui-icons.mjs && node scripts/build-web-strings.mjs",
        "predev": "npm run build:tokens",
        "prebuild": "npm run build:tokens",
        "build:icons": "node scripts/build-icons.mjs"
    },
    "dependencies": {
        "@capacitor/app": "^8.0.0",
        "@capacitor/core": "^8.5.1",
        "@capacitor/device": "^8.0.0",
        "@capacitor/filesystem": "^8.1.3",
        "@capacitor/keyboard": "^8.0.0",
        "@capacitor/preferences": "^8.0.0",
        "@capacitor/share": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.1",
        "@capacitor/ios": "^8.5.1",
        "sharp": "^0.35.4",
        "vite": "^8.0.0"
    },
    "browserslist": [
        "ios_saf >= 15.0"
    ]
}
